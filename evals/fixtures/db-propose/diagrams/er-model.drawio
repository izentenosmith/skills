<mxfile host="app.diagrams.net"><diagram id="er" name="Barker ER Model"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="er-title" value="PawLedger clinic database — Barker ER Model (design rev 3)" style="text;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="600" height="30" as="geometry"/></mxCell><mxCell id="er-legend" value="Legend — Barker notation (CASE*METHOD)&lt;br&gt;soft box = entity, singular UPPERCASE name&lt;br&gt;# UID attribute · * mandatory · o optional&lt;br&gt;solid half-line = must be · dashed half-line = may be&lt;br&gt;crow's foot = one or more · plain end = one and only one&lt;br&gt;bar at an end = relationship is part of the UID" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="1000" y="60" width="320" height="130" as="geometry"/></mxCell><mxCell id="er-provenance" value="Source: design/design.md rev 3 and design/model.json. Assumption: PET – VET (registered with / primary vet of) is inferred from the v1 column pet.primary_vet_id and not confirmed by the practice (Q4)." style="text;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="1000" y="220" width="320" height="80" as="geometry"/></mxCell><mxCell id="er-owner" value="&lt;b&gt;OWNER&lt;/b&gt;&lt;br&gt;# id&lt;br&gt;* first name&lt;br&gt;* last name&lt;br&gt;* phone&lt;br&gt;o email" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="180" height="120" as="geometry"/></mxCell><mxCell id="er-pet" value="&lt;b&gt;PET&lt;/b&gt;&lt;br&gt;# id&lt;br&gt;* name&lt;br&gt;* species&lt;br&gt;o date of birth&lt;br&gt;o microchip" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="360" y="60" width="180" height="120" as="geometry"/></mxCell><mxCell id="er-vet" value="&lt;b&gt;VET&lt;/b&gt;&lt;br&gt;# licence number&lt;br&gt;* name" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="680" y="60" width="180" height="120" as="geometry"/></mxCell><mxCell id="er-vaccine" value="&lt;b&gt;VACCINE&lt;/b&gt;&lt;br&gt;# code&lt;br&gt;* name" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="180" height="120" as="geometry"/></mxCell><mxCell id="er-appointment" value="&lt;b&gt;APPOINTMENT&lt;/b&gt;&lt;br&gt;# id&lt;br&gt;* starts at&lt;br&gt;* duration minutes&lt;br&gt;* reason&lt;br&gt;o notes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="680" y="320" width="180" height="120" as="geometry"/></mxCell><mxCell id="er-reminder" value="&lt;b&gt;REMINDER&lt;/b&gt;&lt;br&gt;# due on&lt;br&gt;o sent at" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="180" height="120" as="geometry"/></mxCell><mxCell id="er-vaccination" value="&lt;b&gt;VACCINATION&lt;/b&gt;&lt;br&gt;# given on&lt;br&gt;* lot number" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="360" y="320" width="180" height="120" as="geometry"/></mxCell><mxCell id="er-rel-pet-owner" value="" style="shape=waypoint;size=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="4" height="4" as="geometry"/></mxCell><mxCell id="er-rel-pet-owner-a" value="owned by" style="html=1;endArrow=none;startArrow=ERmany;startFill=0;dashed=0;" edge="1" parent="1" source="er-pet" target="er-rel-pet-owner"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er-rel-pet-owner-b" value="owner of" style="html=1;endArrow=none;startArrow=none;startFill=0;dashed=1;" edge="1" parent="1" source="er-owner" target="er-rel-pet-ow