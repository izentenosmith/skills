<mxfile host="app.diagrams.net"><diagram id="relational" name="Relational model"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rel-title" value="PawLedger clinic database — Relational model (design rev 3)" style="text;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="600" height="30" as="geometry"/></mxCell><mxCell id="rel-legend" value="Legend — relational notation&lt;br&gt;PK primary key · FK foreign key (arrow: child → parent)&lt;br&gt;UQ unique · NN not null · CK check" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="1000" y="60" width="320" height="80" as="geometry"/></mxCell><mxCell id="rel-provenance" value="Source: design/design.md rev 3 and design/model.json. Entity → table: same name, snake_case (VACCINATION → vaccination)." style="text;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="1000" y="170" width="320" height="60" as="geometry"/></mxCell><mxCell id="rel-owner" value="owner" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;rounded=0;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="260" height="146" as="geometry"/></mxCell><mxCell id="rel-owner-id" value="PK id INTEGER NN" style="text;align=left;spacingLeft=4;html=1;" vertex="1" parent="rel-owner"><mxGeometry x="0" y="26" width="260" height="24" as="geometry"/></mxCell><mxCell id="rel-owner-first_name" value="first_name TEXT NN" style="text;align=left;spacingLeft=4;html=1;" vertex="1" parent="rel-owner"><mxGeometry x="0" y="50" width="260" height="24" as="geometry"/></mxCell><mxCell id="rel-owner-last_name" value="last_name TEXT NN" style="text;align=left;spacingLeft=4;html=1;" vertex="1" parent="rel-owner"><mxGeometry x="0" y="74" width="260" height="24" as="geometry"/></mxCell><mxCell id="rel-owner-phone" value="phone TEXT NN" style="text;align=left;spacingLeft=4;html=1;" vertex="1" parent="