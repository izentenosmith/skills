{
  "name": "invoicer",
  "version": "1.8.2",
  "private": true,
  "description": "Renders customer invoices as HTML and PDF for the billing team.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "20.11.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.21.1",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
